# Leadership demo: set OPENAI_API_KEY for live LLM brief, recommendations, and executive Q&A.
# Without a key, template AI (brief + playbook + copilot Q&A) still runs end-to-end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bridge configuration
LEGACY_API_URL=http://127.0.0.1:5080
DATA_DIR=../data
LLM_BRIEF_ENABLED=true

# Console metadata (shown in header / exports)
DEPLOY_ENV=enterprise
TCC_REGION=us-west-2
TCC_TENANT=primary
TCC_VERSION=1.0.0
TCC_BUILD=release

# Voice narration (Jenny neural — same family as Access Review Copilot)
EDGE_TTS_VOICE=en-US-JennyNeural
